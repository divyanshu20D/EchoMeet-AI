# API Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_SOCKET_URL=http://localhost:3001

# WebRTC Configuration
REACT_APP_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
REACT_APP_TURN_SERVERS=

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false
REACT_APP_ENABLE_PERFORMANCE_MONITORING=false

# Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# Security
REACT_APP_ENABLE_HTTPS=false
REACT_APP_SECURE_COOKIES=false

# UI Configuration
REACT_APP_DEFAULT_THEME=dark
REACT_APP_ENABLE_THEMES=true
REACT_APP_MAX_PARTICIPANTS=100

# Media Configuration
REACT_APP_DEFAULT_VIDEO_QUALITY=720p
REACT_APP_DEFAULT_AUDIO_QUALITY=high
REACT_APP_ENABLE_SCREEN_SHARE=true
REACT_APP_ENABLE_RECORDING=true

# Notification Configuration
REACT_APP_NOTIFICATION_DURATION=5000
REACT_APP_ENABLE_SOUND_NOTIFICATIONS=true

# Development
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false